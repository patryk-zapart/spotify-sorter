# --- Audio features strategy ---
# "openai"  -> infer tempo/energy/danceability/valence/key/mood via OpenAI (default, works for all new Spotify apps)
# "spotify" -> use Spotify's /audio-features endpoint directly (ONLY works if your app was granted
#              an extended-quota exception before Nov 27, 2024 - it 403s for everyone else)
AUDIO_FEATURES_PROVIDER=openai

